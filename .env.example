GEMINI_API_KEY=your_gemini_api_key_here
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Key (后端 API 使用，绕过 RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# XorPay server-only 配置
XORPAY_API_URL=https://xorpay.com
XORPAY_APP_ID=your_xorpay_app_id
XORPAY_APP_SECRET=your_xorpay_app_secret

# Frontend-only payment UI flag
VITE_XORPAY_TEST_MODE=false

# Creem: server-only, scoped to the TradeGrail store. Never reuse another product's keys.
# Test keys/products/webhook secrets must be kept in Development/Preview only.
CREEM_MODE=test
CREEM_CHECKOUT_ENABLED=false
CREEM_APP_ORIGIN=http://127.0.0.1:3017
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRO_MONTHLY_PRODUCT_ID=
CREEM_PRO_YEARLY_PRODUCT_ID=
CREEM_ELITE_MONTHLY_PRODUCT_ID=
CREEM_ELITE_YEARLY_PRODUCT_ID=
