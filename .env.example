# XorPay server-only 配置
XORPAY_API_URL=https://xorpay.com
XORPAY_APP_ID=your_xorpay_app_id
XORPAY_APP_SECRET=your_xorpay_app_secret

# Frontend-only payment UI flag
VITE_XORPAY_TEST_MODE=false
